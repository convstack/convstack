PG_PASS=change-me
AUTHENTIK_SECRET_KEY=change-me-to-a-long-random-string
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me
AUTHENTIK_BOOTSTRAP_EMAIL=admin@convstack.local
CONVSTACK_CLIENT_ID=convstack-dashboard
CONVSTACK_CLIENT_SECRET=change-me-to-a-long-random-string
DASHBOARD_URL=http://localhost:4000
# Where Authentik sends back-channel logouts. Must be reachable from the worker container.
DASHBOARD_INTERNAL_URL=http://host.docker.internal:4000
# Token for the lanyard-service account (view, add, change and delete users). It can
# edit or delete any account, admins included, so keep it as secret as an admin login.
# Same value goes into lanyard's own .env as IDP_API_TOKEN.
LANYARD_API_TOKEN=change-me-to-a-long-random-string
# Where Authentik pushes user changes. Must be reachable from the worker container.
LANYARD_SCIM_URL=http://host.docker.internal:3000/scim/v2
# Same value goes into lanyard's own .env as IDP_SCIM_TOKEN.
LANYARD_SCIM_TOKEN=change-me-to-a-long-random-string
# Social logins. Leave a pair empty to hide that button. Each provider's app needs
# the callback <public Authentik URL>/source/oauth/callback/<discord|google|github>/.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Mail (SMTP). "Sign up" and "Forgot password?" appear on the login screen only
# once AUTHENTIK_EMAIL__HOST is set: both work by mailing a link.
AUTHENTIK_EMAIL__HOST=
AUTHENTIK_EMAIL__PORT=25
AUTHENTIK_EMAIL__USERNAME=
AUTHENTIK_EMAIL__PASSWORD=
AUTHENTIK_EMAIL__USE_TLS=false
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__FROM=convstack@localhost
# Cloudflare Turnstile. Set both to put a captcha in front of sign-up and
# password reset. Set them on any deployment the public can reach.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Tenant avatar mode, applied automatically by the avatar-init container on startup.
# See README for why the default matters.
AUTHENTIK_AVATARS=attributes.avatar_url
